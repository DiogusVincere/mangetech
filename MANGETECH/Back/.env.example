# Copie este arquivo para .env (na mesma pasta do manage.py) e ajuste.
# O .env nunca deve ser versionado.

# Chave do Django. Em produção use uma chave longa, aleatória e fixa.
# Gere uma com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True só em desenvolvimento.
DEBUG=True

# Hosts aceitos, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do front que podem chamar a API (com DEBUG=True qualquer origem é aceita).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# E-mail da recuperação de senha. Sem estas duas variáveis, os e-mails saem no console.
# EMAIL_HOST_USER=seu_email@gmail.com
# EMAIL_HOST_PASSWORD=senha_de_aplicativo
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=noreply@mangetech.local

# URL do front, usada nos links dos e-mails.
# FRONTEND_URL=http://localhost:5173
